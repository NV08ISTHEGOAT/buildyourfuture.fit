<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Build Your Future Installer" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="CardBrush" Color="#161A22"/>
    <SolidColorBrush x:Key="LineBrush" Color="#272D39"/>
    <LinearGradientBrush x:Key="Grad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#7090FF" Offset="0"/>
      <GradientStop Color="#7B5CFF" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Height" Value="54"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="14" Background="{StaticResource Grad}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Small" TargetType="Button">
      <Setter Property="Foreground" Value="#E8ECF4"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Background="#1C212B" BorderBrush="#272D39" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#7090FF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="#E8ECF4"/>
      <Setter Property="CaretBrush" Value="#E8ECF4"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" CornerRadius="10" Background="#0E1117" BorderBrush="#272D39" BorderThickness="1" Padding="10,0">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#7090FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PwField" TargetType="PasswordBox">
      <Setter Property="Foreground" Value="#E8ECF4"/>
      <Setter Property="CaretBrush" Value="#E8ECF4"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Bd" CornerRadius="10" Background="#0E1117" BorderBrush="#272D39" BorderThickness="1" Padding="10,0">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#7090FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Foreground" Value="#9AA4B5"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1C212B"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center"/>
              <Border x:Name="Track" Grid.Column="1" Width="48" Height="28" CornerRadius="14" Background="#39393D" VerticalAlignment="Center">
                <Ellipse x:Name="Knob" Width="22" Height="22" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#34D399"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border CornerRadius="20" Background="#0E1117" BorderBrush="#272D39" BorderThickness="1" Margin="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black"/>
    </Border.Effect>
    <StackPanel Margin="20,16,20,18">
      <Grid x:Name="TitleBar" Background="Transparent" Margin="0,0,0,16">
        <StackPanel Orientation="Horizontal">
          <Image x:Name="Logo" Width="46" Height="46">
            <Image.Clip>
              <RectangleGeometry Rect="0,0,46,46" RadiusX="11" RadiusY="11"/>
            </Image.Clip>
          </Image>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Build Your Future" Foreground="#E8ECF4" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="Subtitle" Text="Installer  -  auto refresh" Foreground="#9AA4B5" FontSize="12"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button x:Name="MinBtn" Style="{StaticResource Chrome}" Content="&#xE921;" ToolTip="Hide to tray"/>
          <Button x:Name="CloseBtn" Style="{StaticResource Chrome}" Content="&#xE8BB;" ToolTip="Close (keeps running in the tray)"/>
        </StackPanel>
      </Grid>

      <Border Style="{StaticResource CardBorder}">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="DeviceDot" Width="12" Height="12" Fill="#5B6475" VerticalAlignment="Center"/>
          <StackPanel Margin="12,0,0,0">
            <TextBlock x:Name="DeviceTitle" Text="Plug in your iPhone" Foreground="#E8ECF4" FontSize="15" FontWeight="Bold"/>
            <TextBlock x:Name="DeviceSub" Text="USB cable, phone unlocked" Foreground="#9AA4B5" FontSize="12"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBorder}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="DaysNumber" Text="-" FontSize="50" FontWeight="Black" Foreground="#E8ECF4" VerticalAlignment="Bottom"/>
            <StackPanel Margin="14,0,0,10" VerticalAlignment="Bottom">
              <TextBlock x:Name="DaysLabel" Text="days left" Foreground="#E8ECF4" FontSize="17" FontWeight="Bold"/>
              <TextBlock x:Name="DaysSub" Text="Free Apple ID: 7 days per install" Foreground="#9AA4B5" FontSize="12"/>
            </StackPanel>
          </StackPanel>
          <Grid Height="8" Margin="0,8,0,0">
            <Border CornerRadius="4" Background="#272D39"/>
            <Border x:Name="DaysBar" CornerRadius="4" Background="#34D399" HorizontalAlignment="Left" Width="0"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBorder}">
        <Grid>
          <StackPanel>
            <TextBlock Text="VERSION" Foreground="#9AA4B5" FontSize="11" FontWeight="Bold"/>
            <TextBlock x:Name="VersionInstalled" Text="On your iPhone: -" Foreground="#E8ECF4" FontSize="14" Margin="0,6,0,2"/>
            <TextBlock x:Name="VersionNewest" Text="Newest: -" Foreground="#9AA4B5" FontSize="13"/>
          </StackPanel>
          <Border x:Name="VersionBadge" CornerRadius="10" Background="#10291F" BorderBrush="#1F5A3F" BorderThickness="1"
                  Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Top">
            <TextBlock x:Name="VersionBadgeText" Text="Up to date" Foreground="#34D399" FontSize="12" FontWeight="Bold"/>
          </Border>
        </Grid>
      </Border>

      <Border Style="{StaticResource CardBorder}" Padding="16,12">
        <StackPanel>
          <Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="APPLE ID" Foreground="#9AA4B5" FontSize="11" FontWeight="Bold"/>
              <TextBlock x:Name="AccountText" Text="Checking..." Foreground="#E8ECF4" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="LoginBtn" Style="{StaticResource Small}" Content="Change" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <StackPanel x:Name="LoginForm" Visibility="Collapsed" Margin="0,12,0,0">
            <TextBlock Text="Apple ID" Foreground="#9AA4B5" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="EmailBox" Style="{StaticResource Field}"/>
            <TextBlock Text="Password" Foreground="#9AA4B5" FontSize="12" Margin="0,10,0,4"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource PwField}"/>
            <StackPanel x:Name="CodePanel" Visibility="Collapsed">
              <TextBlock Text="Code from your iPhone or Mac" Foreground="#9AA4B5" FontSize="12" Margin="0,10,0,4"/>
              <TextBox x:Name="CodeBox" Style="{StaticResource Field}" MaxLength="8"/>
            </StackPanel>
            <Button x:Name="LoginGoBtn" Style="{StaticResource Primary}" Height="44" FontSize="14" Content="Log in" Margin="0,12,0,0"/>
            <TextBlock Foreground="#9AA4B5" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="16">
              Your Apple ID is only used to sign and install Build Your Future on your own iPhone, the same way
              Sideloadly and AltStore do it with a free Apple ID. It goes from this PC straight to Apple, it is never
              sent to Build Your Future, and it is saved only on this PC. You only do this once.
              <Hyperlink x:Name="AppleLink" Foreground="#7090FF">Apple: free Apple ID on-device testing</Hyperlink>
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </Border>

      <Button x:Name="RefreshBtn" Style="{StaticResource Primary}" Content="Refresh now" Margin="0,2,0,12"/>

      <Border Style="{StaticResource CardBorder}" Padding="16,12">
        <CheckBox x:Name="AutoSwitch" Style="{StaticResource Switch}" IsChecked="True">
          <StackPanel>
            <TextBlock Text="Auto-refresh" Foreground="#E8ECF4" FontSize="14" FontWeight="Bold"/>
            <TextBlock x:Name="AutoSub" Text="Opens at 3 days left; new versions install quietly" Foreground="#9AA4B5" FontSize="12"/>
          </StackPanel>
        </CheckBox>
      </Border>

      <TextBlock x:Name="StatusText" Text="Ready." Foreground="#7090FF" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,2,0"/>
      <TextBlock x:Name="Footer" Text="Signs and installs with your Apple ID (built-in engine). No Sideloadly needed."
                 Foreground="#5B6475" FontSize="11" TextWrapping="Wrap" Margin="2,10,2,0"/>
    </StackPanel>
  </Border>
</Window>
